# Copy to .env (git-ignored) and fill in. Real environment variables take priority over .env.
# Used once, on the first start, for the first account "admin" (changed at the first login).
GATESENSE_ADMIN_PASSWORD=

# Where GateSense listens (default 127.0.0.1:8000 = this PC only). For other computers set the host to 0.0.0.0
# and give HTTPS certificate files (PEM); GATESENSE_ALLOW_HTTP=1 runs without HTTPS (not recommended).
# GATESENSE_HOST=127.0.0.1
# GATESENSE_PORT=8000
# GATESENSE_SSL_CERTFILE=C:\certs\gatesense.crt
# GATESENSE_SSL_KEYFILE=C:\certs\gatesense.key
# GATESENSE_ALLOW_HTTP=1

# Camera passwords, used by ${VAR} placeholders in CAMERAS in app/config.py, e.g.
#   "source": "rtsp://gatesense:${GATESENSE_CAM_PASS}@192.168.1.101:554/Streaming/Channels/101"
# Write the password as is: characters like @ # / : are URL-encoded automatically.
# If it contains spaces, # or quotes, put it in single quotes:  GATESENSE_CAM_PASS='p@ss #1'
GATESENSE_CAM_PASS=
